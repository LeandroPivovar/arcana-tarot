# Only the Node.js backend reads these variables. Never add VITE_ to a secret.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001

# Public URLs, optional: the frontend uses these same-origin routes by default.
# VITE_TAROT_METHOD_ENDPOINT=/api/tarot/method
# VITE_TAROT_INTERPRET_ENDPOINT=/api/tarot/interpret

# Banco SQLite com contas e tiragens (criado automaticamente).
DATABASE_PATH=data/arcana.db

# Postgres (obrigatório na Vercel; opcional localmente). Quando definido, substitui o SQLite.
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
